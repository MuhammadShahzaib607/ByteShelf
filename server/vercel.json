{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "models/**",
          "controllers/**",
          "routes/**",
          "utils/**",
          "socket/**"
        ]
      }
    },
    {
      "src": "api/socket.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "models/**",
          "config/**",
          "socket/**",
          "utils/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/socket/(.*)",
      "dest": "/api/socket.js"
    },
    {
      "src": "/api/health",
      "dest": "/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}